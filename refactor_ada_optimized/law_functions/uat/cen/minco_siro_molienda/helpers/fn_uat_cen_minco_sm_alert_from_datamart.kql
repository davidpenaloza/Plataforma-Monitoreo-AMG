let fn_uat_cen_minco_sm_alert_from_datamart = (startTime:datetime, endTime:datetime, productOrigin:string, originModule:string, subtypeContains:string, descriptionContains:string, detailKey:string = "") {
    let base = materialize(
        fn_src_cen_uat_ws_dataplatform("Logs_ANT_Mineral_Tracking_datamart_CL", startTime, endTime)
        | where isempty(productOrigin) or product_origin == productOrigin
        | where isempty(originModule) or origin_module == originModule
        | where isempty(subtypeContains) or subtype contains subtypeContains
        | where isempty(descriptionContains) or description contains descriptionContains
        | extend detail_json = parse_json(detail)
        | extend entity = case(
            isempty(detailKey), coalesce(tostring(detail_json.table), tostring(detail_json.tabla), tostring(detail_json.tag), tostring(origin_module)),
            tostring(detail_json[detailKey])
          )
        | extend entity = iff(isempty(entity), strcat(origin_module, "|", subtype), entity)
    );

    base
    | summarize arg_max(TimeGenerated, alertar, description, subtype) by entity
    | summarize alertas = countif(tobool(alertar) == true), registros = count()
    | project Status = iff(alertas > 0, "ALERT", "OK"), Alertas = alertas, Registros = registros
};
