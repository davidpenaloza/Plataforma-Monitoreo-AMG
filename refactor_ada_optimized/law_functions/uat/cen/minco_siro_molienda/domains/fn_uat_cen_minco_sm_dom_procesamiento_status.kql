let fn_uat_cen_minco_sm_dom_procesamiento_status = (startTime:datetime, endTime:datetime) {
    let task_key = toscalar(fn_uat_cen_minco_sm_catalog() | where Key == "task_key_contains" | project Value);
    let status = toscalar(
        fn_uat_cen_minco_sm_databricks_task_status(startTime, endTime, "", task_key, 30m)
        | project Status
    );
    print status = coalesce(status, "OK")
};
