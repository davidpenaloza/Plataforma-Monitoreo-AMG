let fn_uat_cen_minco_sm_dom_ingestas_status = (startTime:datetime, endTime:datetime) {
    let product_origin_cfg = toscalar(fn_uat_cen_minco_sm_catalog() | where Key == "product_origin" | project Value);
    let detail_key = toscalar(fn_uat_cen_minco_sm_catalog() | where Key == "datamart_detail_key" | project Value);
    let pi_status = toscalar(
        fn_uat_cen_minco_sm_alert_from_datamart(startTime, endTime, product_origin_cfg, "Tabla PI System", "", "", detail_key)
        | project Status
    );
    let jigsaw_status = toscalar(
        fn_uat_cen_minco_sm_alert_from_datamart(startTime, endTime, product_origin_cfg, "Tablas Jigsaw", "", "", detail_key)
        | project Status
    );
    let status = fn_uat_cen_minco_sm_status_rollup(pack_array(pi_status, jigsaw_status));
    print status
};
