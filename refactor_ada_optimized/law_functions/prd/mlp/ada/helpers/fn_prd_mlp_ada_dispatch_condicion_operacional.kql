let fn_prd_mlp_ada_dispatch_condicion_operacional = (startTime:datetime, endTime:datetime) {
  fn_src_mlp_ws_dataplatform("Logs_MLP_ADA_CL", startTime, endTime)
  | where product_origin == "DISPATCH_CONDICION_OPERACIONAL"
  | top 1 by TimeGenerated desc
  | extend
      CH1 = tostring(detail["CH-1"]),
      CH2 = tostring(detail["CH-02"])
  | project CH1, CH2
};
