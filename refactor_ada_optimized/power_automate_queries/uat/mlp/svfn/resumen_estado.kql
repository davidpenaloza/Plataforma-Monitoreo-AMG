// Resumen operativo para SENSOR VIRTUAL FLUJO NaSH (SVFN) en MLP UAT.
let lookback = 1h;
let fuente_notpii_interpolated = fn_uat_mlp_svfn_dom_fuente_notpii_interpolated_status(ago(lookback), now());
let tags = fn_uat_mlp_svfn_dom_tags_status(ago(lookback), now());
let transformacion = fn_uat_mlp_svfn_dom_transformacion_status(ago(lookback), now());
let prediccion = fn_uat_mlp_svfn_dom_prediccion_status(ago(lookback), now());

union
    (fuente_notpii_interpolated | project orden = 1, producto = "NotPII_Interpolated", estado = print_0),
    (tags | project orden = 2, producto = "Tags", estado = print_0),
    (transformacion | project orden = 3, producto = "Transformacion", estado = print_0),
    (prediccion | project orden = 4, producto = "Prediccion", estado = print_0)
| extend color = fn_mon_status_to_color(estado)
| extend icono = iff(estado == "ALERT", "🔴", "🟢")
| project orden, producto, estado, color, icono
| order by orden asc
