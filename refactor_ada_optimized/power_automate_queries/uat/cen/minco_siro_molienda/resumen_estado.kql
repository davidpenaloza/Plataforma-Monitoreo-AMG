// Ventana de observación estándar para MINCO - Siro Molienda (Centinela).
let startTime = ago(3h);
let endTime = now();
let ingesta_pisystem = toscalar(fn_uat_cen_minco_sm_dom_ingesta_pisystem_status(startTime, endTime));
let ingesta_mt = toscalar(fn_uat_cen_minco_sm_dom_ingesta_mt_status(startTime, endTime));
let smol_dimensions = materialize(fn_uat_cen_minco_sm_dom_smol_dimensions_status(startTime, endTime));
let procesamiento_features = toscalar(smol_dimensions | project Procesamiento_Features);
let recomendacion = toscalar(smol_dimensions | project Recomendacion);
let reentrenamiento = toscalar(smol_dimensions | project Reentrenamiento);

union
    (print orden = 1, producto = "Ingesta_PISystem", estado = ingesta_pisystem),
    (print orden = 2, producto = "Ingesta_MT", estado = ingesta_mt),
    (print orden = 3, producto = "Procesamiento_Features", estado = procesamiento_features),
    (print orden = 4, producto = "Recomendacion", estado = recomendacion),
    (print orden = 5, producto = "Reentrenamiento", estado = reentrenamiento)
| extend color = case(
    estado == "Critical", "#E53935",
    estado == "Warning", "#FFF4CC",
    "#EAF4EA"
)
| extend icono = case(
    estado == "Critical", "🔴",
    estado == "Warning", "🟡",
    estado == "OK", "🟢",
    "⚪"
)
| project orden, producto, estado, color, icono
| order by orden asc
