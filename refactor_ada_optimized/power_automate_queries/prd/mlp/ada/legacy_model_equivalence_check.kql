// Comparación REAL de equivalencia entre modelo legacy y modelo refactor.
// Reemplazar <LEGACY_RESULT_QUERY> por la query legacy original que retorna una fila
// con columnas: NRT Dispatch, Drillit, Blockgrade, PI, Plans, Meteo, KPIs, Alarmas, Front, Optimizador Mezcla, Settings.
let lookback = 24h;
let startTime = ago(lookback);
let endTime = now();

let legacy_raw =
    (<LEGACY_RESULT_QUERY>)
    | project
        ['NRT Dispatch'],
        Drillit,
        Blockgrade,
        PI,
        Plans,
        Meteo,
        KPIs,
        Alarmas,
        Front,
        ['Optimizador Mezcla'],
        Settings;

let legacy_domains =
legacy_raw
| project producto="Dispatch", legacy_estado=iff(['NRT Dispatch']=="Alertar","ALERT","OK")
| union (legacy_raw | project producto="Drillit", legacy_estado=iff(['Drillit']=="Alertar","ALERT","OK"))
| union (legacy_raw | project producto="Blockgrade", legacy_estado=iff(['Blockgrade']=="Alertar","ALERT","OK"))
| union (legacy_raw | project producto="PI", legacy_estado=iff(['PI']=="Alertar","ALERT","OK"))
| union (legacy_raw | project producto="Plans", legacy_estado=iff(['Plans']=="Alertar","ALERT","OK"))
| union (legacy_raw | project producto="Meteodata", legacy_estado=iff(['Meteo']=="Alertar","ALERT","OK"))
| union (legacy_raw | project producto="KPI", legacy_estado=iff(['KPIs']=="Alertar","ALERT","OK"))
| union (legacy_raw | project producto="Alarmas", legacy_estado=iff(['Alarmas']=="Alertar","ALERT","OK"))
| union (legacy_raw | project producto="Front", legacy_estado=iff(['Front']=="Alertar","ALERT","OK"))
| union (legacy_raw | project producto="OptimizadorMezcla", legacy_estado=iff(['Optimizador Mezcla']=="Alertar","ALERT","OK"))
| union (legacy_raw | project producto="Settings", legacy_estado=iff(['Settings']=="Alertar","ALERT","OK"));

let refactor_domains = union
    (fn_prd_mlp_ada_dom_dispatch_status(startTime,endTime)    | project producto="Dispatch",          refactor_estado=status),
    (fn_prd_mlp_ada_dom_drillit_status(startTime,endTime)     | project producto="Drillit",           refactor_estado=status),
    (fn_prd_mlp_ada_dom_blockgrade_status(startTime,endTime)  | project producto="Blockgrade",        refactor_estado=status),
    (fn_prd_mlp_ada_dom_pi_status(startTime,endTime)          | project producto="PI",                refactor_estado=status),
    (fn_prd_mlp_ada_dom_plans_status(startTime,endTime)       | project producto="Plans",             refactor_estado=status),
    (fn_prd_mlp_ada_dom_meteodata_status(startTime,endTime)   | project producto="Meteodata",         refactor_estado=status),
    (fn_prd_mlp_ada_dom_kpi_status(startTime,endTime)         | project producto="KPI",               refactor_estado=status),
    (fn_prd_mlp_ada_dom_alarm_status(startTime,endTime)       | project producto="Alarmas",           refactor_estado=status),
    (fn_prd_mlp_ada_dom_front_status(startTime,endTime)       | project producto="Front",             refactor_estado=status),
    (fn_prd_mlp_ada_dom_optimizador_status(startTime,endTime) | project producto="OptimizadorMezcla", refactor_estado=status),
    (fn_prd_mlp_ada_dom_settings_status(startTime,endTime)    | project producto="Settings",          refactor_estado=status);

legacy_domains
| join kind=fullouter refactor_domains on producto
| extend producto = coalesce(producto, producto1)
| extend legacy_estado=coalesce(legacy_estado,"N/A"),
         refactor_estado=coalesce(refactor_estado,"N/A"),
         match=legacy_estado==refactor_estado
| project producto, legacy_estado, refactor_estado, match
| order by producto asc
