// Validación comparativa refactor (dominios) vs diagnóstico job-level ADA.
// Objetivo: revisar equivalencia funcional frente al enfoque legacy.
let lookback = 24h;
let startTime = ago(lookback);
let endTime = now();
let jobs_detail =
    fn_prd_mlp_ada_jobs_status_detail(startTime, endTime)
    | project TimeGeneratedBin_Chile, domain, jobName, jobAlias, status, statusText, isAlert, realCount, expectedCount, expectedVsRealPct;
let jobs_rollup =
    jobs_detail
    | summarize
        total_jobs = dcount(jobName),
        alerts_jobs = countif(isAlert == true),
        warnings_jobs = countif(status == "w"),
        saturated_jobs = countif(status == "s")
      by domain, TimeGeneratedBin_Chile
    | extend status_jobs_detail = iff(alerts_jobs > 0, "ALERT", "OK");
let jobs_latest =
    jobs_rollup
    | summarize arg_max(TimeGeneratedBin_Chile, *) by domain;
let summary_domains =
    union
      (fn_prd_mlp_ada_dom_dispatch_status(startTime, endTime) | project domain = "NRT Dispatch", status_domain = iff(color == "#E53935", "ALERT", "OK")),
      (fn_prd_mlp_ada_dom_kpi_status(startTime, endTime) | project domain = "KPIs", status_domain = iff(color == "#E53935", "ALERT", "OK")),
      (fn_prd_mlp_ada_dom_alarm_status(startTime, endTime) | project domain = "Alarmas", status_domain = iff(color == "#E53935", "ALERT", "OK")),
      (fn_prd_mlp_ada_dom_optimizador_status(startTime, endTime) | project domain = "Optimizador Mezcla", status_domain = iff(color == "#E53935", "ALERT", "OK")),
      (fn_prd_mlp_ada_dom_settings_status(startTime, endTime) | project domain = "Settings", status_domain = iff(color == "#E53935", "ALERT", "OK"));
let global =
    fn_prd_mlp_ada_dom_global_status(startTime, endTime)
    | project Dispatch, KPI, Alarmas, ['Optimizador Mezcla'], Settings;
jobs_latest
| join kind=fullouter summary_domains on domain
| extend status_jobs_detail = coalesce(status_jobs_detail, "N/A")
| extend parity = iff(status_jobs_detail == "N/A", "NO_JOB_SIGNAL", iff(status_jobs_detail == status_domain, "MATCH", "DIFF"))
| extend alert_ratio = iff(total_jobs == 0 or isnull(total_jobs), real(null), todouble(alerts_jobs) / todouble(total_jobs))
| extend JoinKey = 1
| join kind=leftouter (global | extend JoinKey = 1) on JoinKey
| project-away JoinKey, JoinKey1
| project
    TimeGeneratedBin_Chile,
    domain,
    status_domain,
    status_jobs_detail,
    parity,
    total_jobs,
    alerts_jobs,
    alert_ratio,
    warnings_jobs,
    saturated_jobs,
    Dispatch,
    KPI,
    Alarmas,
    ['Optimizador Mezcla'],
    Settings,
    startTime,
    endTime
| order by domain asc
